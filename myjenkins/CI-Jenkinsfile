pipeline {
    agent any

    tools {
        maven 'mymaven3'   // Maven 3.9.6
        jdk 'myjdk17'      // Java 17
    }

    environment {
        IMAGE_NAME = 'akash87970/akashproject'
        IMAGE_TAG = '1.0.0'
        DOCKER_CONTEXT = 'mydocker'
        DOCKER_CREDENTIALS_ID = 'mydockerhub'  // Jenkins credentials ID for Docker Hub
    }

    stages {
        
        stage('1. Build the Bookstore Application') {
            steps {
                echo '🛠️ Building the Spring Boot WAR with Java 17...'
                sh 'mvn clean install package'
            }
        }

        stage('2. Copy WAR to Docker Context') {
            steps {
                echo '📦 Copying WAR to Docker folder...'
                sh 'mkdir -p ${DOCKER_CONTEXT}'
                sh 'cp target/*.war ${DOCKER_CONTEXT}/ROOT.war'
            }
        }

        stage('3. Build and Push Docker Image') {
            steps {
                script {
                    echo "🐳 Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
                    def customImage = docker.build("${IMAGE_NAME}:${IMAGE_TAG}", "${DOCKER_CONTEXT}")
                    
                    docker.withRegistry('https://registry-1.docker.io/v2/', "${DOCKER_CREDENTIALS_ID}") {
                        customImage.push()
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ Image pushed successfully to Docker Hub!'
        }
        failure {
            echo '❌ Build or push failed. Please check console output.'
        }
    }
}
